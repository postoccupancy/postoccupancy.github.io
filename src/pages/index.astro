---
// Fundation
import BaseLayout from "@/layouts/BaseLayout.astro";

// Components
import Hero from "@/components/sections/Hero.astro";
import ProjectList from "@/components/sections/ProjectList.astro";

// Files
import { getEntry } from "astro:content";
const index = await getEntry("files", "index")
if (!index) {
  throw new Error("Home page data was not found.")
}

// Collections
import { getCollection } from "astro:content";
const prototypes = await getCollection("prototypes");

---

<BaseLayout>
  <Hero heading={index.data.heading}/>
  <ProjectList collection={prototypes} />
</BaseLayout>
